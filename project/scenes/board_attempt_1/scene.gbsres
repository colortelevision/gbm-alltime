        "true": [
          {
            "id": "f2b4470c-cf51-4ede-8e75-03cf299a4d3b",
            "command": "EVENT_TEXT",
            "args": {
              "text": [
                "GRIDDUEL\n24 cards + leader\nDrop ONE card per turn\nbeside your leader.",
                "Each piece can move\nand attack once per\nturn. Green=move.\nRed=attack target.",
                "Circle > Triangle\nTriangle > Square\nSquare > Circle\nBattle bonus: 500",
                "Reduce enemy LP to 0\nor surround leader.\nTraps stay hidden\nuntil stepped on.",
                "SELECT: hand/pieces\nA: pick / act\nB: info / cancel\nSTART: end turn",
                "Jumps: landing only.\nArrows fly OVER traps.\nB on empty: quit.\nNo permanent losses.",
                "Empty deck: lose\n500 LP each own turn.\nLeader cannot attack.\nB: inspect card effects."
              ]
            }
          },
          {
            "id": "81eeb3f5-fe03-4f08-975b-5bf4859f9806",
